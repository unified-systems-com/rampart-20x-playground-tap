          "rev": "v0.7.0",
          "commit": "0dda8929401c8105bec2469c824173ed5aee401a"
        }
      },
      {
        "slug": "computing_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/computing-core-tap",
          "rev": "v0.8.0",
          "commit": "9b85706722313fd2afae978940acbebaa1985289"
        }
      },
      {
        "slug": "git_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/git-core-tap",
          "rev": "v0.1.1",
          "commit": "9e941010f155f1223340ff404d7cbd14cd1db1e0"
        }
      },
      {
        "slug": "compliance_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/compliance-core-tap",
          "rev": "v0.7.0",
          "commit": "946f6a23fb03b3a2f03982228379c91d67e96434"
        }
      },
      {
        "slug": "github_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/github-core-tap",
          "rev": "v0.13.1",
          "commit": "32252db4c59e8a10a118d476435f1cb324f800f9"
        },
        "note": "Installed after git_core and compliance_core: each entry is installed on its own, so a sibling distribution it depends on must already be present (github_core 0.13.0 requires git-core-tap, tap-plugin-compliance-core and tap-plugin-identity-core)."
      },
      {
        "slug": "fedramp_20x_ksi",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/fedramp-20x-ksi-tap",
          "rev": "v0.4.0",
          "commit": "a29f112bb4a5feeb53f6783830e69716ac4c231d"
        }
      },
      {
        "slug": "rampart_20x",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/CriticalSecLLC/rampart-20x-tap",
          "rev": "d97460e11141623ead50074e463353c9f280d83c",
          "commit": "d97460e11141623ead50074e463353c9f280d83c"
        },
        "note": "Untagged: rampart-20x-tap has no release tags, so this pins the SHA of its main at the time this record was written (2026-10-13)."
      },
      {
        "slug": "rampart_20x_playground",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/CriticalSecLLC/rampart-20x-playground-tap",
          "rev": "v0.1.0"
        },
        "note": "Self entry: pinned to its own release tag, which scripts/release-plugin.sh cuts after the scaffold merges (a record cannot carry the commit that introduces it; self is exempt from `commit` only when `rev` is its release tag). Until then `spawn --dev-plugins` needs a record copy pointing self at a branch."
      }
    ]
  },
  "population": {
    "on_failure": "abort",
    "steps": [
      {
        "type": "seed-plugin",
        "plugin": "administrivia",
        "enabled": true,
        "note": "TAP admin pages and grid landing."
      },
      {
        "type": "seed-plugin",
        "plugin": "dcom",
        "enabled": true,
        "note": "The dcom axis, so the `design` dimension node exists for seeded entities to carry."
      },
      {
        "type": "seed-plugin",
        "plugin": "aws_core",
        "bundle": "dimension",
        "enabled": true,
        "note": "aws_core's vocabulary dimension nodes only; its pages and region seed arrive when a page mounts them."
      },
      {
        "type": "seed-plugin",
        "plugin": "computing_core",
        "bundle": "dimension",
        "enabled": true,
        "note": "computing_core's vocabulary dimension nodes only."
      },
      {
        "type": "seed-plugin",
        "plugin": "fedramp_20x_ksi",
        "bundle": "dimension",
        "enabled": true,
        "note": "fedramp_20x_ksi's vocabulary dimension nodes only; its KSI seed, pages and schedule stay out until the VDR pages need them."
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "enabled": true,
        "note": "This plugin's own bundles: keystone and dimensions. Last, so every dimension it references already exists."
      }
    ]
  },
  "web": {
    "landing_entity_id": "01a13b2c-82d6-73d2-baa8-17415ac66a72",
    "landing_slug": "/playground"
  }
}
