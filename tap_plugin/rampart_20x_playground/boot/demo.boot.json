{
  "version": 1,
  "profile_kind": "dev_local",
  "description": "rampart_20x_playground demo record: identity_core, administrivia, dcom, aws_core, computing_core, git_core, compliance_core, github_core, fedramp_20x_ksi and rampart_20x, plus this plugin, each pinned by the peeled commit SHA beside its tag (rampart_20x is untagged and pinned by its main SHA). No collector runs and no credential is required: the data is mock. Okta, Duo, Teleport and highbar are deliberately absent. Login is by the local passkey that spawn-session.sh replays into the stack (req-tap-auth-passkey-dev-bootstrap), not by anything in this record.",
  "install": {
    "plugins": [
      {
        "slug": "identity_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/identity-core-tap",
          "rev": "v0.1.3",
          "commit": "53da388b6f47590090ef3bdc8d98731acff4c8e2"
        }
      },
      {
        "slug": "administrivia",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/administrivia-tap",
          "rev": "v0.2.0",
          "commit": "cf205b31e83ff8774cfae59db4810a4d9bd06aea"
        }
      },
      {
        "slug": "dcom",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/dcom-tap",
          "rev": "v0.1.0",
          "commit": "932762f34a2cdbc112f66be18babbb4488ce929b"
        }
      },
      {
        "slug": "aws_core",
