{
  "version": 1,
  "description": "rampart_20x_playground CI record (req-boot-bootstrap-ci-record): the stack this plugin's own tests run in. The install set is the depends_on closure (github_core, which needs git_core, identity_core and compliance_core; aws_core; computing_core; dcom) plus this plugin, because the bundles write github_core, compliance_core, aws_core, computing_core and identity_core types and carry the dcom dimension. The consumer substitutes the checkout under test for the self entry, so the CHECKOUT runs. Population seeds this plugin's own GRIFT, which proves every bundle parses and imports against a real grid. DELIBERATELY EXCLUDED: every other plugin, all credentials, all required_secrets and any step that reaches the network beyond the pinned installs, so a fork can run this lane and it cannot flake on a third party.",
  "install": {
    "plugins": [
      {
        "slug": "identity_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/identity-core-tap",
          "rev": "v0.1.3",
          "commit": "53da388b6f47590090ef3bdc8d98731acff4c8e2"
        }
      },
      {
        "slug": "dcom",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/dcom-tap",
          "rev": "v0.1.0",
          "commit": "932762f34a2cdbc112f66be18babbb4488ce929b"
        }
      },
      {
        "slug": "aws_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/aws-core-tap",
          "rev": "v0.7.0",
          "commit": "0dda8929401c8105bec2469c824173ed5aee401a"
        }
      },
      {
        "slug": "computing_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/computing-core-tap",
          "rev": "v0.8.0",
          "commit": "9b85706722313fd2afae978940acbebaa1985289"
        }
      },
      {
        "slug": "git_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/git-core-tap",
          "rev": "v0.1.1",
          "commit": "9e941010f155f1223340ff404d7cbd14cd1db1e0"
        }
      },
      {
        "slug": "compliance_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/compliance-core-tap",
          "rev": "v0.7.0",
          "commit": "946f6a23fb03b3a2f03982228379c91d67e96434"
        }
      },
      {
        "slug": "github_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/github-core-tap",
          "rev": "v0.13.0",
          "commit": "dddae9baf958ce09a08be79b96a63b3c7ca86364"
        },
        "note": "Installed after git_core and compliance_core: each entry is installed on its own, so a sibling distribution it depends on must already be present (github_core 0.13.0 requires git-core-tap, tap-plugin-compliance-core and tap-plugin-identity-core)."
      },
      {
        "slug": "rampart_20x_playground",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/CriticalSecLLC/rampart-20x-playground-tap",
          "rev": "v0.1.0"
        }
      }
    ]
  },
  "population": {
    "on_failure": "abort",
    "steps": [
      {
        "type": "seed-plugin",
        "plugin": "dcom",
        "enabled": true,
        "note": "The dcom axis, so the design dimension node exists for seeded entities to carry."
      },
      {
        "type": "seed-plugin",
        "plugin": "aws_core",
        "bundle": "dimension",
        "enabled": true,
        "note": "aws_core's vocabulary dimension nodes only."
      },
      {
        "type": "seed-plugin",
        "plugin": "computing_core",
        "bundle": "dimension",
        "enabled": true,
        "note": "computing_core's vocabulary dimension nodes only."
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "enabled": true,
        "note": "Own GRIFT: keystone, dimensions and the security-alerts batch."
      }
    ]
  }
}
