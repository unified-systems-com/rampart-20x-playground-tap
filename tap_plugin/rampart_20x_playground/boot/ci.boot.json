{
  "version": 1,
  "description": "rampart_20x_playground CI record (req-boot-bootstrap-ci-record): the stack this plugin's own tests run in. The install set is the depends_on closure (github_core, which needs git_core, identity_core and compliance_core; aws_core; computing_core; dcom) plus this plugin, because the bundles write github_core, compliance_core, aws_core, computing_core and identity_core types and carry the dcom dimension. The consumer substitutes the checkout under test for the self entry, so the CHECKOUT runs. Population seeds this plugin's own GRIFT, which proves every bundle parses and imports against a real grid. DELIBERATELY EXCLUDED: every other plugin, all credentials, all required_secrets and any step that reaches the network beyond the pinned installs, so a fork can run this lane and it cannot flake on a third party.",
  "install": {
    "plugins": [
      {
        "slug": "identity_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/identity-core-tap",
          "rev": "v0.1.8",
          "commit": "c6a1d1dc28bfd627533d3adbb3af819910d62d19"
        }
      },
      {
        "slug": "dcom",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/dcom-tap",
          "rev": "v0.1.2",
          "commit": "f901a410b8389e2fe8a608719697f62c3cfb1f01"
        }
      },
      {
        "slug": "computing_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/computing-core-tap",
          "rev": "v0.11.0",
          "commit": "e80e953802aac9974a4d33bf9c140dd9f1bb9dfe"
        }
      },
      {
        "slug": "aws_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/aws-core-tap",
          "rev": "v0.9.1",
          "commit": "ae8cb12bfb5cfbff064f3cece56396cbbb15ca26"
        }
      },
      {
        "slug": "git_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/git-core-tap",
          "rev": "v0.1.3",
          "commit": "06dd42cb4a6a2933e7df6d94ba5150e5a28749e6"
        }
      },
      {
        "slug": "compliance_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/compliance-core-tap",
          "rev": "v0.8.15",
          "commit": "d45aa0b90fcd34cc16e70030bc9740b6dd7702f7"
        }
      },
      {
        "slug": "sigstore_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/sigstore-core-tap",
          "rev": "v0.5.4",
          "commit": "95687752825c3380b11c331cd2381b534c4119d0"
        }
      },
      {
        "slug": "github_core",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/github-core-tap",
          "rev": "v0.14.3",
          "commit": "e815fc790586cde118c868ea65a4a634c892d022"
        },
        "note": "Installed after git_core and compliance_core: each entry is installed on its own, so a sibling distribution it depends on must already be present (github_core 0.13.0 requires git-core-tap, tap-plugin-compliance-core and tap-plugin-identity-core)."
      },
      {
        "slug": "fedramp_20x_vdr",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/fedramp-20x-vdr-tap",
          "rev": "v0.1.8",
          "commit": "416e3bd6d7653313c988c7ca3ef0e0aba61aa3a8"
        },
        "note": "Installed after compliance_core: the coverage_snapshot collector subclasses compliance_core's SearchSnapshotCollector (first shipped in v0.8.7), and the classification mapping bundle's hourly Schedule targets that collector."
      },
      {
        "slug": "rampart_20x_playground",
        "enabled": true,
        "source": {
          "type": "git",
          "url": "https://github.com/unified-systems-com/rampart-20x-playground-tap",
          "rev": "v0.4.1"
        }
      }
    ]
  },
  "population": {
    "on_failure": "abort",
    "steps": [
      {
        "type": "seed-plugin",
        "plugin": "dcom",
        "enabled": true,
        "note": "The dcom axis, so the design dimension node exists for seeded entities to carry."
      },
      {
        "type": "seed-plugin",
        "plugin": "aws_core",
        "bundle": "dimension",
        "enabled": true,
        "note": "aws_core's vocabulary dimension nodes only."
      },
      {
        "type": "seed-plugin",
        "plugin": "computing_core",
        "bundle": "dimension",
        "enabled": true,
        "note": "computing_core's vocabulary dimension nodes only."
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "dimension",
        "enabled": true,
        "note": "The dimension vocabulary, first: the bundles after it stamp `team.responsible`. Core 0.4 and later imports it on its own before any step; this step is what seeds it on an older core."
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "keystone",
        "enabled": true,
        "note": "Own GRIFT, one bundle per step: every bundle but pain, which needs stackarmor_vdr, a private repository this offline record does not install."
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "dimensions",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "security_alerts",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "actor_dimensions",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "mock_inventory",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "inventory_entities",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "inventory_software",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "application_flow",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "vulnerability_enrichment",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "vulnerabilities_page",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "inventory_coverage",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "inventory_page",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "fedramp_20x_vdr",
        "bundle": "run_configuration",
        "enabled": true,
        "note": "fedramp_20x_vdr's not-configurable run configurations for vdr_max and coverage_snapshot, which the classification_mapping and vdr_max_page Schedules target (req-tap-cares-runconfig-seed-guard-3)."
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "classification_mapping",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "data_classification_page",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "coverage_seed",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "coverage_panel",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "pages",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "teams",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "reporting_page",
        "enabled": true
      },
      {
        "type": "seed-plugin",
        "plugin": "rampart_20x_playground",
        "bundle": "vdr_max_page",
        "enabled": true
      }
    ]
  }
}
