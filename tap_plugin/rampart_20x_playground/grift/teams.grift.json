        {
          "entity": {
            "entity_id": "01a15c19-6922-734d-9272-2043c1dc947e",
            "entity_type": "search",
            "name": "playground — teams teams",
            "dimensions": {}
          },
          "node": {
            "name": "playground — teams teams",
            "description": "One row per team. The parent team is not a column because Gryphon cannot project a field of an optional match (a plain match would drop git-serious, which has no parent); the missing capability is a left-outer join that returns the optional side's fields.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (t:identity_core__team)",
                "RETURN t.entity_id AS entity_id, t.name AS name, t.data.description AS description",
                "ORDER BY name ASC"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a15c19-6922-734d-9272-2044fbc49e3f",
            "entity_type": "search",
            "name": "playground — teams leaders",
            "dimensions": {}
          },
          "node": {
            "name": "playground — teams leaders",
            "description": "One row per leader of a team.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (h:identity_core__human)-[:LEADS_TEAM__identity_core]->(t:identity_core__team)",
                "RETURN t.name AS team, h.entity_id AS entity_id, h.name AS name"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a15c19-6922-734d-9272-20450c1b85f3",
            "entity_type": "search",
