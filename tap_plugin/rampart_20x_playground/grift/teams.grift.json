            "root": "node",
            "definition": {
              "query": [
                "MATCH (h:identity_core__human)-[:BELONGS_TO_TEAM__identity_core]->(t:identity_core__team)",
                "RETURN t.name AS team, h.entity_id AS entity_id, h.name AS name"
              ]
            }
