          "node": {
            "name": "playground \u2014 landing task-open-findings",
            "description": "The open findings on each ECS task, from the packages of its container's image host and the libraries its container's programs load, each finding counted once: one count per task (findings, not distinct vulnerabilities). A module Search because Gryphon has no multi-path aggregate (a union of MATCH clauses cannot be aggregated across, and a projection with aggregates needs one MATCH): the missing capability is a count of what several different routes reach, counted once.",
            "search_type": "module",
            "root": "node",
            "definition": {
              "runner_key": "tap_plugin.compliance_core.searches.reach:findings-reached-count"
            },
            "input_schema": {
              "type": "object",
              "description": "Which roots, and which routes from a root to what carries its findings.",
              "properties": {
                "root_type": {
                  "type": "string",
                  "default": "aws_core__aws_ecs_task",
                  "description": "The type of the nodes the count and the list are for."
                },
                "paths": {
                  "type": "array",
                  "default": [
                    [
                      "RUNS_CONTAINER__aws_core",
                      "RUNS_IMAGE__computing_core",
                      "INSTALLS_PACKAGE__computing_core"
                    ],
                    [
                      "RUNS_CONTAINER__aws_core",
                      "RUNS_PROGRAM__computing_core",
                      "RUNS_PROGRAM__computing_core",
                      "LOADS_LIBRARY__computing_core"
                    ]
                  ],
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "description": "Edge-type chains followed outward from a task: its container's image host's packages, and the libraries its container's programs load."
