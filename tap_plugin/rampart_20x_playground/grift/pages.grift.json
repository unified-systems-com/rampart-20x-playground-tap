      "nodes": [
        {
          "entity": {
            "entity_id": "01a13b2c-82d6-73d2-baa8-17353bda4c2c",
            "entity_type": "search",
            "name": "playground \u2014 landing nodes",
            "dimensions": {}
          },
          "node": {
            "name": "playground \u2014 landing nodes",
            "description": "Every node of the mock GovCloud deployment: the organization, its accounts and what the product account holds.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (n)",
                "WHERE n.entity_type IN [\"aws_core__aws_organization\", \"aws_core__aws_account\", \"aws_core__aws_vpc\", \"aws_core__aws_subnet\", \"aws_core__aws_internet_gateway\", \"aws_core__aws_alb\", \"aws_core__aws_ecs_cluster\", \"aws_core__aws_ecs_service\", \"aws_core__aws_ecs_task\", \"aws_core__aws_rds_instance\", \"aws_core__aws_secrets_manager_secret\", \"aws_core__aws_kms_key\", \"aws_core__aws_ecr_repository\", \"aws_core__aws_route53_zone\", \"aws_core__aws_acm_certificate\"]",
                "RETURN n"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a13b2c-82d6-73d2-baa8-17366a8674bc",
            "entity_type": "search",
            "name": "playground \u2014 landing enrolls",
            "dimensions": {}
          },
          "node": {
            "name": "playground \u2014 landing enrolls",
            "description": "Each account the organization enrolls.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (a:aws_core__aws_organization)-[:ENROLLS_ACCOUNT__aws_core]->(b:aws_core__aws_account)",
                "RETURN a, b"
              ]
            }
          }
        },
        {
          "entity": {
