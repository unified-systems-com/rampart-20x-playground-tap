            "name": "playground \u2014 landing belongs",
            "description": "Each resource and the account that owns it.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (a)-[:BELONGS_TO_ACCOUNT__aws_core]->(b:aws_core__aws_account)",
                "WHERE a.entity_type IN [\"aws_core__aws_organization\", \"aws_core__aws_account\", \"aws_core__aws_vpc\", \"aws_core__aws_subnet\", \"aws_core__aws_internet_gateway\", \"aws_core__aws_alb\", \"aws_core__aws_ecs_cluster\", \"aws_core__aws_ecs_service\", \"aws_core__aws_ecs_task\", \"aws_core__aws_rds_instance\", \"aws_core__aws_secrets_manager_secret\", \"aws_core__aws_kms_key\", \"aws_core__aws_ecr_repository\", \"aws_core__aws_route53_zone\", \"aws_core__aws_acm_certificate\"]",
                "RETURN a, b"
              ]
            }
          }
