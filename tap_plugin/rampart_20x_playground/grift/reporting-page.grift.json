            }
          },
          "node": {
            "name": "Agency Report",
            "slug": "playground-reporting-agency",
            "description": "The part of the status report written to be sent to agencies: coverage and vulnerabilities, live.",
            "view": "compliance_core/panels/report.html",
            "editor_view": "",
            "config": {
              "title": "Status Report",
              "show_as_of": true,
              "hide_header": true,
              "sections": [
                {
                  "heading": "Coverage",
                  "items": [
                    {
                      "kind": "figure",
                      "label": "Responsibility Coverage",
                      "search": "01a16098-57bd-7444-a312-2ffdd24c4174",
                      "field": "percent_overall",
                      "format": "percent",
                      "of": "denominator"
                    },
                    {
                      "kind": "figure",
                      "label": "Data Classification Coverage",
                      "search": "01a16098-57be-71da-9424-40b57d974dd7",
                      "field": "percent_overall",
                      "format": "percent",
                      "of": "denominator"
                    },
                    {
                      "kind": "trend",
                      "label": "Coverage Over Time",
                      "lines": [
                        {
                          "label": "Responsibility",
                          "search": "01a16098-57bd-7444-a312-2ffbc5719ad7",
                          "x_field": "observed_at",
                          "value_field": "value",
                          "series_field": "series",
                          "series": "Overall"
                        },
                        {
                          "label": "Data Classification",
                          "search": "01a16098-57bd-7444-a312-2ffc2d3549d0",
                          "x_field": "observed_at",
                          "value_field": "value",
                          "series_field": "series",
                          "series": "Overall"
                        }
                      ]
                    }
                  ]
                },
                {
                  "heading": "Vulnerabilities",
                  "items": [
                    {
                      "kind": "figure",
                      "label": "Open Vulnerabilities",
                      "search": "01a1714d-1e78-7757-af1c-499307627d3d",
                      "field": "open_vulnerabilities",
                      "format": "count"
                    },
                    {
                      "kind": "figure",
                      "label": "Known Exploited",
                      "search": "01a1714d-1e78-7757-af1c-4994d7d354c6",
                      "field": "known_exploited",
                      "format": "count"
                    }
                  ]
                }
              ]
            }
          }
