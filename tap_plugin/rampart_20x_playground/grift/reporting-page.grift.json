                      "field": "last_snapshot",
                      "format": "datetime"
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a1714d-1e78-7757-af1c-499307627d3d",
            "entity_type": "search",
            "name": "playground — report open vulnerabilities",
            "dimensions": {}
          },
          "node": {
            "name": "playground — report open vulnerabilities",
            "description": "Open findings that concern a vulnerability, counted.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (f:compliance_core__compliance_finding)-[:CONCERNS_COMPLIANCE_VULNERABILITY__compliance_core]->(v:compliance_core__compliance_vulnerability) WHERE f.data.status = \"open\"",
                "RETURN COUNT(f) AS open_vulnerabilities"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a1714d-1e78-7757-af1c-4994d7d354c6",
            "entity_type": "search",
            "name": "playground — report known exploited",
            "dimensions": {}
          },
          "node": {
            "name": "playground — report known exploited",
            "description": "Open findings whose vulnerability is on CISA's Known Exploited Vulnerabilities catalog, counted.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (f:compliance_core__compliance_finding)-[:CONCERNS_COMPLIANCE_VULNERABILITY__compliance_core]->(v:compliance_core__compliance_vulnerability) WHERE f.data.status = \"open\" AND v.data.kev = true",
                "RETURN COUNT(f) AS known_exploited"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a1714d-1e78-7757-af1c-4995a2f811bf",
            "entity_type": "search",
            "name": "playground — report last snapshot",
            "dimensions": {}
          },
          "node": {
            "name": "playground — report last snapshot",
            "description": "When the latest Search snapshot was observed: the newest observed_at of any compliance_search_snapshot, null when there is none.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (s:compliance_core__compliance_search_snapshot)",
                "RETURN MAX(s.data.observed_at) AS last_snapshot"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a17339-8ab3-7025-b71e-cac113451e11",
            "entity_type": "search",
            "name": "playground — report deadlines",
            "dimensions": {}
          },
          "node": {
            "name": "playground — report deadlines",
            "description": "vdr-summary, the counts row for the Deadlines section: evaluation_overdue, remediation_overdue, acceptance_reached and detection_unobserved in one row. Remediation and acceptance are a worst-case bound: in v0 every finding is counted from first detection under the worst-case row and no evaluation is complete (req-fedramp-20x-vdr-deadlines-4).",
            "search_type": "module",
            "root": "node",
            "definition": {
              "runner_key": "tap_plugin.fedramp_20x_vdr.searches.clocks:vdr-summary"
            },
            "input_schema": {
              "type": "object",
              "properties": {
                "view": {
                  "type": "string",
                  "default": "counts"
                }
              }
            }
          }
        }
      ],
