          "node": {
            "name": "playground — stackarmor one finding",
            "description": "stackarmor-pain for the finding in the page's entity_id (the first memo example without one).",
            "search_type": "module",
            "root": "node",
            "definition": {
              "runner_key": "tap_plugin.stackarmor_vdr.searches.pain:stackarmor-pain"
            },
            "input_schema": {
              "type": "object",
              "properties": {
                "entity_id": {
                  "type": "string",
                  "default": "220c378a-49d9-7ce4-b50f-15de8555fff5",
                  "description": "The finding: the highest-PAIN real finding on the live data when this was set (N4, glibc-2.44); a runner input that picks it on read is pending."
                }
              }
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a16114-6c12-7238-bbd7-48df36ff5ac7",
            "entity_type": "search",
            "name": "playground — stackarmor stamps",
            "dimensions": {}
          },
          "node": {
            "name": "playground — stackarmor stamps",
            "description": "The programs with a stackarmor stamp and what each states, leaving out the memo's example programs.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (s:stackarmor_vdr__asset_profile)-[:PROFILES_PROGRAM__stackarmor_vdr]->(p:computing_core__program)",
                "WHERE NOT s.data.stamp_key STARTS_WITH \"example-\"",
                "RETURN p.name AS program, s.data.stamp_key AS stamp, s.data.cr AS cr, s.data.ir AS ir, s.data.ar AS ar, s.data.multi_agency AS multi_agency, s.data.rationale AS rationale"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a16114-6c12-7238-bbd7-48e073733e93",
            "entity_type": "search",
            "name": "playground — stackarmor archetypes",
            "dimensions": {}
          },
          "node": {
            "name": "playground — stackarmor archetypes",
            "description": "The archetype catalog.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (a:stackarmor_vdr__archetype)",
                "RETURN a.data.name AS name, a.data.cr AS cr, a.data.ir AS ir, a.data.ar AS ar, a.data.description AS description",
                "ORDER BY name ASC"
              ]
            }
          }
