      "batch_node": {
        "source": "tap_plugin.rampart_20x_playground.grift.inventory-coverage",
        "name": "rampart-20x-playground inventory coverage v0.1.0",
        "description": "The responsibility coverage Search, the history and live totals Searches of both coverage charts, the eight coverage cards and the two coverage charts, mounted on the Inventory and Data Classification pages. The classification mapping summary Search and the hourly Schedule that records both summaries are in the classification mapping bundle."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "01a15fdf-61ef-710d-b5d3-e3a7ae238a40",
            "entity_type": "search",
            "name": "playground — responsibility coverage",
            "dimensions": {}
          },
          "node": {
            "name": "playground — responsibility coverage",
            "description": "How many entities of each inventory category have a responsible team: one row per category. A module Search because Gryphon cannot write a count grouped by a dimension value taken from an input. The mapping is one row naming every entity type and the key team.responsible with no allowed values, so any set value counts as covered. Recorded every hour by the coverage_snapshot collector of fedramp_20x_vdr.",
            "search_type": "module",
            "root": "node",
            "definition": {
              "runner_key": "tap_plugin.compliance_core.searches.dimension_mapping:dimension-mapping-summary"
            },
            "input_schema": {
              "type": "object",
              "description": "Inputs of the runner; every one has a default, so the Search runs with none.",
              "properties": {
                "mappings": {
                  "type": "array",
                  "default": [
                    {
                      "label": "Responsibility",
                      "entity_types": [
                        "*"
                      ],
                      "keys": [
                        {
                          "key": "team.responsible"
                        }
                      ],
                      "match": "all"
                    }
                  ],
                  "description": "One row for every entity type: an entity is covered when team.responsible is set to any value."
                },
                "group_by": {
                  "type": "string",
                  "default": "inventory",
                  "description": "The dimension key whose value is the group an entity is counted in: the inventory category."
                },
                "exclude_groups": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "Groups left out of the result: none."
                }
              }
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a16098-57bd-7444-a312-2ffbc5719ad7",
            "entity_type": "search",
            "name": "playground — responsibility coverage history",
            "dimensions": {}
          },
          "node": {
            "name": "playground — responsibility coverage history",
            "description": "The responsibility coverage over time, one point per category per snapshot. Reads the snapshots that coverage_snapshot (fedramp_20x_vdr) records every hour, one point per category per snapshot and a plain-average Overall line.",
            "search_type": "module",
            "root": "node",
            "definition": {
              "runner_key": "tap_plugin.compliance_core.searches.snapshot_series:search-snapshot-series"
            },
            "input_schema": {
              "type": "object",
              "description": "Inputs of the runner; every one has a default, so the Search runs with none.",
              "properties": {
                "search_id": {
                  "type": "string",
                  "default": "01a15fdf-61ef-710d-b5d3-e3a7ae238a40",
                  "description": "The entity id of the summary Search whose snapshots are read."
                },
                "series_field": {
                  "type": "string",
                  "default": "label",
                  "description": "The row field whose value names the line: the category."
                },
                "value_field": {
                  "type": "string",
                  "default": "percent_mapped",
                  "description": "The row field that is the point's number: the percent covered."
                },
                "max_snapshots": {
                  "type": "integer",
                  "default": 500,
                  "description": "The most recent snapshots read: 500, so that ten lines stay inside the chart's 5000 rows."
                }
              }
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a16098-57bd-7444-a312-2ffc2d3549d0",
            "entity_type": "search",
            "name": "playground — classification coverage history",
            "dimensions": {}
          },
          "node": {
