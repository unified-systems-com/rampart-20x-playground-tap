          "node": {
            "name": "Data classification introduction",
            "slug": "playground-data-classification-intro",
            "description": "Explains the two data classifications and how to read the cards.",
            "view": "tap_web/panels/text_panel.html",
            "editor_view": "tap_web/panels/text_panel_editor.html",
            "config": {
              "text": "Every component can carry a data classification: a label saying what kind of data it holds or handles. There are two classifications. dataclass.customer is about data that belongs to customers; dataclass.infra is about data that belongs to running the infrastructure. Each takes one value per component, and each card below describes its classification, describes every value it can take, counts the components that carry one, and breaks that count down by the kind of component, value by value. A value no component carries is shown with none, not hidden.",
              "hide_header": true
            }
          }
        },
