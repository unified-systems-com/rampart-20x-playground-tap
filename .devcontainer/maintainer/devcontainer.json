{
  "name": "Rampart 20x Playground - maintainer",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "devbox",
  "runServices": [
    "devbox",
    "web",
    "db"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/sshd@sha256:f5251b8e4325f68f7280973c6cd65daff414449c66f240621502d4e8e74eb7ee": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker@sha256:698f5900fac471e046c6e9d4333fec88c0e8d952c713494fa0712dce80baeca0": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli@sha256:7c409bf6316ffd85f04fd92fba85a744282639e603417dd4796409866bdb6805": {}
  },
  "initializeCommand": "cd .devcontainer && touch .codespace-secret-key tap-codespace.env && chmod 666 .codespace-secret-key tap-codespace.env && { [ -s .env ] || printf 'POSTGRES_PASSWORD=%s\\nTAP_SEARCH_READONLY_PASSWORD=%s\\n' \"$(openssl rand -hex 24)\" \"$(openssl rand -hex 24)\" > .env; }",
  "postStartCommand": "bash /workspace/.devcontainer/maintainer/post-start.sh",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Rampart 20x Playground",
      "onAutoForward": "silent"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  }
}
