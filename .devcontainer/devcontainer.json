{
  "name": "Rampart 20x Playground",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "web",
  "workspaceFolder": "/welcome",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "initializeCommand": "cd .devcontainer && touch tap-codespace.env codespace-identity.env && chmod 666 tap-codespace.env codespace-identity.env",
  "postAttachCommand": "sh /opt/playground/site-ready.sh",
  "postStartCommand": "sh /opt/playground/codespace-identity.sh /run/tap-codespace-identity.env",
  "forwardPorts": [
    8000
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "readme"
      }
    }
  },
  "portsAttributes": {
    "8000": {
      "label": "Rampart 20x Playground",
      "onAutoForward": "openBrowser"
    }
  }
}
